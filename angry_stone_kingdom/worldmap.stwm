(supertux-level
  (version 3)
  (name (_ "Angry Stone's Kingdom"))
  (author "Angry Stone's Kingdom contributors")
  (license "CC0-1.0")
  (icon "/images/worldmap/angry_stone_kingdom/king-hud.png")
  (icon-locked "/images/worldmap/angry_stone_kingdom/king-hud.png")
  (bkg "/images/worldmap/angry_stone_kingdom/kingdom-map.png")
  (tileset "images/angry_stone_kingdom.strf")
  (allow-item-pocket "on")
  (sector
